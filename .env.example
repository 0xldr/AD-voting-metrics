# Copy this file to .env and fill in your own values.
# .env is gitignored and should never be committed.

# Dune Analytics API key.
# Get one at https://dune.com/settings/api
DUNE_API_KEY=

# Path to the Google Cloud service-account JSON file used to authenticate
# with the Google Sheets API. Create the service account in Google Cloud
# Console, download the JSON key, and store it outside the repo (e.g.,
# ~/.config/ad-voting-metrics/service-account.json). The service account
# email must be added as Editor on the workbook below.
GOOGLE_SERVICE_ACCOUNT_FILE=

# Google Sheets workbook ID. Find it in the workbook URL between /d/ and
# /edit. The workbook must be shared with the service account email above.
SHEETS_WORKBOOK_ID=